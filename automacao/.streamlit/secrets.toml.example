# ============================================================
#  CONFIGURAÇÃO DO SISTEMA — PARECER PRÓ-CIDADES / MCID
#
#  INSTRUÇÕES:
#  1. Copie este arquivo e renomeie para: secrets.toml
#     (na mesma pasta .streamlit)
#  2. Preencha os valores abaixo
#  3. Nunca compartilhe o arquivo secrets.toml com ninguém
#     fora da equipe — ele contém chaves de API
# ============================================================

# Senha de acesso ao sistema (combinada com a equipe)
app_password = "senha-da-equipe"

# ---- Ollama (IA local — opcional) ----
# Necessário apenas se usar IA rodando localmente
# Deixe como está se for usar apenas provedores em nuvem
ollama_host = "http://localhost:11434"

# ---- Groq (RECOMENDADO — gratuito, rápido, privado) ----
# Crie conta gratuita em: https://console.groq.com
# Clique em "API Keys" → "Create API Key"
groq_api_key = ""

# ---- Mistral AI (alta qualidade, privado) ----
# Crie conta em: https://console.mistral.ai
# "API Keys" → "Create new key"
mistral_api_key = ""

# ---- OpenAI (GPT-4o — alta qualidade) ----
# Crie conta em: https://platform.openai.com
# Requer plano pago (a partir de ~USD 5)
openai_api_key = ""

# ---- Anthropic / Claude (opcional) ----
# Crie conta em: https://console.anthropic.com
anthropic_api_key = ""

# ---- Azure OpenAI (opcional — uso corporativo) ----
azure_openai_api_key = ""
azure_openai_endpoint = ""
azure_openai_deployment = ""
