# Deploy Intranet — Sistema Debêntures Incentivadas (MCID)
# Copie para .env e preencha

# Senha de acesso da equipe (obrigatório em produção)
APP_PASSWORD=senha-segura-da-equipe

# Host do Ollama (em Docker Compose usa http://ollama:11434)
OLLAMA_HOST=http://ollama:11434

# PostgreSQL (opcional). Se definido, repositórios e feedbacks usam a BD; caso contrário, ficheiros locais.
# DATABASE_URL=postgresql+psycopg2://usuario:senha@localhost:5432/debentures
